# Copy to .env to override the defaults used by docker-compose.yml.
# These are local-development values only; never reuse them elsewhere.
API_PORT=8080
DB_NAME=notifications
DB_USER=app
DB_PASSWORD=app

# Only used when running the API natively (npm start) outside Docker.
# Compose always sets DB_HOST=db and DB_PORT=5432 for the API container.
PORT=8080
DB_HOST=localhost
DB_PORT=5432
